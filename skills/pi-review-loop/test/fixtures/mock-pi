#!/usr/bin/env bash
# Mock `pi` binary for BATS tests of orchestrate.sh.
#
# Behaviour:
#   - Appends its own argv to $MOCK_PI_CALL_LOG (one JSON array per line)
#     and to $MOCK_PI_ARGV_LOG (raw arguments, one per line).
#   - If $MOCK_PI_FIXTURES_DIR is set, looks for a numbered fixture file
#     $MOCK_PI_FIXTURES_DIR/<call-count> where call-count is the number
#     of lines now in the call log after this invocation. If that file
#     does not exist, the call succeeds with empty output (pi returning
#     nothing is a valid pi behavior; tests that expect a response must
#     provide the fixture).
#   - If the fixture starts with "EXIT:" it encodes a non-zero exit:
#     the first line is EXIT:<code> and the remaining lines are emitted
#     on stderr (simulating a pi crash / auth failure).
#   - If the fixture starts with "SLEEP:<n>" it sleeps n seconds first
#     (used to exercise the driver's PI_TIMEOUT path), then emits the
#     remaining lines on stdout and exits 0.
#   - If the fixture starts with "SLEEP-IGNORE-TERM:<n>" it ignores
#     SIGTERM (trap), then spawns `sleep n` in a child process so that
#     GNU timeout's process-group kill cannot reach the sleep directly.
#     This exercises the SIGKILL escalation path (--kill-after → rc 137).
#   - Otherwise the fixture is emitted on stdout and the call exits 0.

log_call() {
  # One JSON array per call: each argument is JSON-encoded with jq -Rs,
  # so the assembled array is always valid JSON.
  local args_json="["
  local sep=""
  local arg
  for arg in "$@"; do
    local encoded
    encoded="$(printf '%s' "$arg" | jq -Rs '.')"
    args_json="${args_json}${sep}${encoded}"
    sep=','
    printf '%s\n' "$arg" >>"${MOCK_PI_ARGV_LOG:-/dev/null}" 2>/dev/null || true
  done
  args_json="${args_json}]"
  printf '%s\n' "$args_json" >>"${MOCK_PI_CALL_LOG:-/dev/null}" 2>/dev/null || true
}

log_call "$@"
n="$(wc -l <"$MOCK_PI_CALL_LOG" | tr -d ' ')"

# Capture stdin content (the prompt is passed via stdin by the driver).
# If MOCK_PI_STDIN_LOG is set, write the stdin content there. Then close
# stdin so bare fixtures (SLEEP) don't hang.
stdin_content="$(cat)"
if [ -n "${MOCK_PI_STDIN_LOG:-}" ]; then
  printf '%s\n' "$stdin_content" >> "$MOCK_PI_STDIN_LOG"
fi
exec </dev/null

if [ -n "${MOCK_PI_FIXTURES_DIR:-}" ] && [ -f "$MOCK_PI_FIXTURES_DIR/$n" ]; then
  first="$(head -n 1 "$MOCK_PI_FIXTURES_DIR/$n")"
  case "$first" in
    EXIT:*)
      code="${first#EXIT:}"
      tail -n +2 "$MOCK_PI_FIXTURES_DIR/$n" >&2
      exit "$code"
      ;;
    COMMIT:*)
      # Simulate a develop round that commits its own work: stage and
      # commit, then emit the remaining lines as pi output. If there is
      # nothing to commit, `git commit` exits non-zero (1) — that is
      # expected here, not a failure of the mock, so swallow it and still
      # exit 0 like a successful pi call.
      git add -A
      git commit -qm "${first#COMMIT:}" || true
      tail -n +2 "$MOCK_PI_FIXTURES_DIR/$n"
      ;;
    SLEEP:*)
      sleep "${first#SLEEP:}"
      tail -n +2 "$MOCK_PI_FIXTURES_DIR/$n"
      ;;
    SLEEP-IGNORE-TERM:*)
      # Ignore SIGTERM in the mock shell, then spawn `sleep` as a child.
      # GNU timeout kills the child's process group on deadline (SIGTERM);
      # the mock shell traps and ignores it, and the `sleep` child dies.
      # At kill-after expiry, SIGKILL terminates the whole group → rc 137.
      trap "" TERM
      sleep "${first#SLEEP-IGNORE-TERM:}"
      tail -n +2 "$MOCK_PI_FIXTURES_DIR/$n"
      ;;
    PUSH:*)
      # Simulate a pi process that attempts `git push origin HEAD`. The push
      # runs with the current environment (so GIT_CONFIG_* neutralisation is
      # in effect). The push's stderr is discarded; its exit code is appended
      # to $MOCK_PI_PUSH_LOG (a side file the test reads) so the result is
      # not routed through pi's stdout (which the driver parses as JSON
      # events and would swallow).
      git push origin HEAD 2>/dev/null
      printf '%s\n' "$?" >>"${MOCK_PI_PUSH_LOG:-/dev/null}"
      tail -n +2 "$MOCK_PI_FIXTURES_DIR/$n"
      ;;
    *)
      cat "$MOCK_PI_FIXTURES_DIR/$n"
      ;;
  esac
fi

exit 0
