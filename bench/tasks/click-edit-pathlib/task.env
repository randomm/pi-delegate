# Task: click-edit-pathlib (pallets/click #3781)
#
# Safe-execution contract: setup-run.sh fetches only BASE_SHA (single
# commit, no refs/tags), and TEST_CMD/SETUP_CMD run with
# GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat
# under `timeout 120` — see docs/benchmark.md §safe-execution.
REPO=https://github.com/randomm/click.git
BASE_SHA=2103e157683c5e4cadc8ee1838df526a54bde9a4
FIX_SHA=e1fd5946ab26aaf372009eaff1acf947140b40fb
SETUP_CMD='uv venv -p 3.13 "$PWD/venv" && uv pip install -p "$PWD/venv/bin/python" -e . "pytest>=8,<9"'
TEST_CMD='export GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat; timeout 120 "$PWD/venv/bin/python" -m pytest tests/test_termui.py -q --no-header -p no:cacheprovider && timeout 300 "$PWD/venv/bin/python" -m pytest tests/ -q --no-header -p no:cacheprovider --deselect tests/test_utils/test__expand_args.py::test_expand_args'
GRADING_TESTS='tests/test_termui.py'
GRADING_PATCH=grading.patch
