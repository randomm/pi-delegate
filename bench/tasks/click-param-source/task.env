# Task: click-param-source (pallets/click #3458) — MVS
#
# Safe-execution contract: setup-run.sh fetches only BASE_SHA (single
# commit, no refs/tags), and TEST_CMD/SETUP_CMD run with
# GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat
# under `timeout 120` — see docs/benchmark.md §safe-execution.
REPO=https://github.com/randomm/click.git
BASE_SHA=4b24a6c8f6658ef89fd6db4dcaf8ee88eef75dfa
FIX_SHA=7d05a59b9d46a415d85937630d1d812cf477f60a
SETUP_CMD='uv venv -p 3.13 "$PWD/venv" && uv pip install -p "$PWD/venv/bin/python" -e . "pytest>=8,<9"'
TEST_CMD='export GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat; timeout 120 "$PWD/venv/bin/python" -m pytest tests/test_defaults.py tests/test_options.py -q --no-header -p no:cacheprovider && timeout 300 "$PWD/venv/bin/python" -m pytest tests/ -q --no-header -p no:cacheprovider --deselect tests/test_utils/test__expand_args.py::test_expand_args'
GRADING_TESTS='tests/test_defaults.py tests/test_options.py'
GRADING_PATCH=grading.patch
