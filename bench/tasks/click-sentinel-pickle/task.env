# Task: click-sentinel-pickle (pallets/click #3805) — MVS
#
# Safe-execution contract: setup-run.sh fetches only BASE_SHA (single
# commit, no refs/tags), and TEST_CMD/SETUP_CMD run with
# GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat
# under `timeout 120` — see docs/benchmark.md §safe-execution.
REPO=https://github.com/randomm/click.git
BASE_SHA=3cbcf9b11546f4cf10b36d3e2e531733ba6fe001
FIX_SHA=4295457ddc7b5ca9a733d59ca40d9651b02b9b1d
SETUP_CMD='uv venv -p 3.13 "$PWD/venv" && uv pip install -p "$PWD/venv/bin/python" -e . "pytest>=8,<9"'
TEST_CMD='export GIT_TERMINAL_PROMPT=0 EDITOR=true VISUAL=true PAGER=cat GIT_PAGER=cat; timeout 120 "$PWD/venv/bin/python" -m pytest tests/test_utils/test_sentinel.py -q --no-header -p no:cacheprovider && timeout 300 "$PWD/venv/bin/python" -m pytest tests/ -q --no-header -p no:cacheprovider --deselect tests/test_utils/test__expand_args.py::test_expand_args'
GRADING_TESTS='tests/test_utils/test_sentinel.py'
GRADING_PATCH=grading.patch
